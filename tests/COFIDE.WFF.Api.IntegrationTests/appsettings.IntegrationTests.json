// Configuración NO sensible de las pruebas de integración (sí se versiona).
// Conexiones y credenciales van en Resources/Configuracion/conexiones.json (copia de conexiones.example.json,
// excluida de git) o en variables de entorno WFF_IT_... en el pipeline.
// Si falta la cadena de conexión, las pruebas que la requieren se OMITEN (no fallan).
{
  "ConnectionStrings": {
    "OracleConnection": ""
  },

  // Sin reintentos en segundo plano durante las pruebas (los correos ya están reemplazados por un doble).
  "PublicacionEventos": {
    "MaximoReintentos": 0
  },

  "IntegrationTests": {
    // Pruebas contra servicios externos reales (SUC). Activar solo en QA (en conexiones.json o WFF_IT_IntegrationTests__ApisExternasHabilitadas=true)
    "ApisExternasHabilitadas": false,

    // Usuario simulado para las peticiones autenticadas. Debe existir en la base de datos de pruebas.
    "Usuario": {
      "CodigoUsuario": "USR_PRUEBA",
      "UserIdLocal": 1,
      "Dni": "00000000",
      "AreaId": 1,
      "AreaNombre": "AREA PRUEBA",
      "AreaPadreId": 1,
      "AreaDescripcionCorta": "PRB",
      "CargoId": 1,
      "GerenciaNombre": "GERENCIA PRUEBA",
      "CodigoRolUsuario": "SOLAPR",
      "Correo": "usuario.prueba@cofide.com.pe",
      "Nombre": "Usuario",
      "ApellidoPaterno": "Prueba",
      "ApellidoMaterno": "Integracion"
    }
  }
}
